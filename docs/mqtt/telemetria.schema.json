{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgroVigia - telemetria v1 (solo payload)",
  "description": "No valida topico, autorizacion, catalogo, duplicados, fecha de calendario ni ventana temporal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "nodo_codigo",
    "mensaje_id",
    "origen",
    "tomada_en",
    "mediciones"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "nodo_codigo": {
      "type": "string",
      "pattern": "^agv-[a-z0-9]+-[0-9]{2}$"
    },
    "mensaje_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "origen": {
      "enum": [
        "real",
        "simulado"
      ]
    },
    "tomada_en": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "mediciones": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions/temperatura"
              },
              {
                "$ref": "#/definitions/humedad"
              }
            ]
          },
          "allOf": [
            {
              "contains": {
                "$ref": "#/definitions/temperatura"
              }
            },
            {
              "contains": {
                "$ref": "#/definitions/humedad"
              }
            }
          ]
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/definitions/iluminacion"
          }
        }
      ]
    }
  },
  "definitions": {
    "temperatura": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable_codigo",
        "valor",
        "unidad"
      ],
      "properties": {
        "variable_codigo": {
          "const": "temperatura_aire"
        },
        "valor": {
          "type": "number",
          "minimum": -40,
          "maximum": 80,
          "multipleOf": 0.0001
        },
        "unidad": {
          "const": "°C"
        }
      }
    },
    "humedad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable_codigo",
        "valor",
        "unidad"
      ],
      "properties": {
        "variable_codigo": {
          "const": "humedad_aire"
        },
        "valor": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.0001
        },
        "unidad": {
          "const": "% HR"
        }
      }
    },
    "iluminacion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable_codigo",
        "valor",
        "unidad"
      ],
      "properties": {
        "variable_codigo": {
          "const": "iluminacion_relativa"
        },
        "valor": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.0001
        },
        "unidad": {
          "const": "% relativo"
        }
      }
    }
  }
}
