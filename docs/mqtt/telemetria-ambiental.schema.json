{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgroVigia - ambiental v2 DHT22 + indice ADC LDR",
  "description": "Indice relativo ADC; no lux. Validar tambien formula, calendario, canal, permisos y transaccion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "nodo_codigo",
    "mensaje_id",
    "origen",
    "tomada_en",
    "mediciones",
    "ldr"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 2
    },
    "nodo_codigo": {
      "type": "string",
      "pattern": "^agv-[a-z0-9]+-[0-9]{2}$"
    },
    "mensaje_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "origen": {
      "enum": [
        "real",
        "simulado"
      ]
    },
    "tomada_en": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "mediciones": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/temperatura"
          },
          {
            "$ref": "#/definitions/humedad"
          },
          {
            "$ref": "#/definitions/iluminacion"
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "$ref": "#/definitions/temperatura"
          }
        },
        {
          "contains": {
            "$ref": "#/definitions/humedad"
          }
        },
        {
          "contains": {
            "$ref": "#/definitions/iluminacion"
          }
        }
      ]
    },
    "ldr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metodo",
        "adc_promedio"
      ],
      "properties": {
        "metodo": {
          "const": "adc12_10k_11db_v1"
        },
        "adc_promedio": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        }
      }
    }
  },
  "definitions": {
    "temperatura": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable_codigo",
        "valor",
        "unidad"
      ],
      "properties": {
        "variable_codigo": {
          "const": "temperatura_aire"
        },
        "valor": {
          "type": "number",
          "minimum": -40,
          "maximum": 80,
          "multipleOf": 0.0001
        },
        "unidad": {
          "const": "°C"
        }
      }
    },
    "humedad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable_codigo",
        "valor",
        "unidad"
      ],
      "properties": {
        "variable_codigo": {
          "const": "humedad_aire"
        },
        "valor": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.0001
        },
        "unidad": {
          "const": "% HR"
        }
      }
    },
    "iluminacion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable_codigo",
        "valor",
        "unidad"
      ],
      "properties": {
        "variable_codigo": {
          "const": "iluminacion_relativa"
        },
        "valor": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 0.0001
        },
        "unidad": {
          "const": "% relativo"
        }
      }
    }
  }
}
