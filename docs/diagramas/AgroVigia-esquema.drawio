        <object id="agv-p6-c79" label="" tabla="mediciones" vista="referencia" restricciones_sql="FOREIGN KEY (cultivo_id) REFERENCES cultivos(id) ON DELETE RESTRICT&#10;NOT NULL cultivo_id&#10;UNIQUE (id, cultivo_id, nodo_id, variable_codigo, origen)&#10;UNIQUE (id, cultivo_id, origen)&#10;NOT NULL id&#10;CHECK (length(mensaje_id) = 36 AND mensaje_id ~ '^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'::text)&#10;NOT NULL mensaje_id&#10;CHECK (jsonb_typeof(metadatos) = 'object'::text)&#10;NOT NULL metadatos&#10;UNIQUE (nodo_id, mensaje_id, variable_codigo)&#10;NOT NULL nodo_id&#10;FOREIGN KEY (nodo_id, variable_codigo) REFERENCES nodo_variables(nodo_id, variable_codigo) ON DELETE RESTRICT&#10;CHECK (origen = ANY (ARRAY['real'::text, 'simulado'::text]))&#10;NOT NULL origen&#10;PRIMARY KEY (id)&#10;NOT NULL recibida_en&#10;NOT NULL tomada_en&#10;CHECK (valor &lt;&gt; 'NaN'::numeric)&#10;NOT NULL valor&#10;NOT NULL variable_codigo" indices_sql="CREATE INDEX mediciones_consulta ON public.mediciones USING btree (cultivo_id, nodo_id, variable_codigo, origen, tomada_en DESC)&#10;CREATE UNIQUE INDEX mediciones_id_cultivo_id_nodo_id_variable_codigo_origen_key ON public.mediciones USING btree (id, cultivo_id, nodo_id, variable_codigo, origen)&#10;CREATE UNIQUE INDEX mediciones_id_cultivo_id_origen_key ON public.mediciones USING btree (id, cultivo_id, origen)&#10;CREATE UNIQUE INDEX mediciones_nodo_id_mensaje_id_variable_codigo_key ON public.mediciones USING btree (nodo_id, mensaje_id, variable_codigo)&#10;CREATE UNIQUE INDEX mediciones_pkey ON public.mediciones USING btree (id)" tooltip="mediciones&#10;FOREIGN KEY (cultivo_id) REFERENCES cultivos(id) ON DELETE RESTRICT&#10;NOT NULL cultivo_id&#10;UNIQUE (id, cultivo_id, nodo_id, variable_codigo, origen)&#10;UNIQUE (id, cultivo_id, origen)&#10;NOT NULL id&#10;CHECK (length(mensaje_id) = 36 AND mensaje_id ~ '^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'::text)&#10;NOT NULL mensaje_id&#10;CHECK (jsonb_typeof(metadatos) = 'object'::text)&#10;NOT NULL metadatos&#10;UNIQUE (nodo_id, mensaje_id, variable_codigo)&#10;NOT NULL nodo_id&#10;FOREIGN KEY (nodo_id, variable_codigo) REFERENCES nodo_variables(nodo_id, variable_codigo) ON DELETE RESTRICT&#10;CHECK (origen = ANY (ARRAY['real'::text, 'simulado'::text]))&#10;NOT NULL origen&#10;PRIMARY KEY (id)&#10;NOT NULL recibida_en&#10;NOT NULL tomada_en&#10;CHECK (valor &lt;&gt; 'NaN'::numeric)&#10;NOT NULL valor&#10;NOT NULL variable_codigo">
