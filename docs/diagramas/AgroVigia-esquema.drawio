        <object id="agv-p5-c8" label="" tabla="alertas" vista="completa" restricciones_sql="NOT NULL abierta_en&#10;CHECK ((cerrada_en IS NULL) = (motivo_cierre IS NULL))&#10;CHECK ((revisada_en IS NULL) = (revisada_por IS NULL))&#10;FOREIGN KEY (cultivo_id) REFERENCES cultivos(id)&#10;NOT NULL cultivo_id&#10;NOT NULL id&#10;CHECK (limite = ANY (ARRAY['inferior'::text, 'superior'::text]))&#10;NOT NULL limite&#10;FOREIGN KEY (medicion_cierre_id, cultivo_id, nodo_id, variable_codigo, origen) REFERENCES mediciones(id, cultivo_id, nodo_id, variable_codigo, origen)&#10;FOREIGN KEY (medicion_inicial_id, cultivo_id, nodo_id, variable_codigo, origen) REFERENCES mediciones(id, cultivo_id, nodo_id, variable_codigo, origen)&#10;NOT NULL medicion_inicial_id&#10;FOREIGN KEY (medicion_ultima_id, cultivo_id, nodo_id, variable_codigo, origen) REFERENCES mediciones(id, cultivo_id, nodo_id, variable_codigo, origen)&#10;NOT NULL medicion_ultima_id&#10;CHECK (motivo_cierre = ANY (ARRAY['dentro_de_rango'::text, 'cambio_de_limite'::text, 'regla_desactivada'::text, 'nodo_desvinculado'::text]))&#10;FOREIGN KEY (nodo_id) REFERENCES nodos(id)&#10;NOT NULL nodo_id&#10;CHECK (origen = ANY (ARRAY['real'::text, 'simulado'::text]))&#10;NOT NULL origen&#10;PRIMARY KEY (id)&#10;FOREIGN KEY (regla_id) REFERENCES reglas_alerta(id)&#10;NOT NULL regla_id&#10;FOREIGN KEY (revisada_por) REFERENCES perfiles(id)&#10;NOT NULL ultima_tomada_en&#10;NOT NULL umbral&#10;NOT NULL valor_inicial&#10;NOT NULL valor_ultimo&#10;NOT NULL variable_codigo" indices_sql="CREATE INDEX alertas_cultivo_fecha ON public.alertas USING btree (cultivo_id, abierta_en DESC, id DESC)&#10;CREATE UNIQUE INDEX alertas_pkey ON public.alertas USING btree (id)&#10;CREATE UNIQUE INDEX episodio_abierto ON public.alertas USING btree (regla_id, nodo_id, origen) WHERE (cerrada_en IS NULL)" tooltip="alertas&#10;NOT NULL abierta_en&#10;CHECK ((cerrada_en IS NULL) = (motivo_cierre IS NULL))&#10;CHECK ((revisada_en IS NULL) = (revisada_por IS NULL))&#10;FOREIGN KEY (cultivo_id) REFERENCES cultivos(id)&#10;NOT NULL cultivo_id&#10;NOT NULL id&#10;CHECK (limite = ANY (ARRAY['inferior'::text, 'superior'::text]))&#10;NOT NULL limite&#10;FOREIGN KEY (medicion_cierre_id, cultivo_id, nodo_id, variable_codigo, origen) REFERENCES mediciones(id, cultivo_id, nodo_id, variable_codigo, origen)&#10;FOREIGN KEY (medicion_inicial_id, cultivo_id, nodo_id, variable_codigo, origen) REFERENCES mediciones(id, cultivo_id, nodo_id, variable_codigo, origen)&#10;NOT NULL medicion_inicial_id&#10;FOREIGN KEY (medicion_ultima_id, cultivo_id, nodo_id, variable_codigo, origen) REFERENCES mediciones(id, cultivo_id, nodo_id, variable_codigo, origen)&#10;NOT NULL medicion_ultima_id&#10;CHECK (motivo_cierre = ANY (ARRAY['dentro_de_rango'::text, 'cambio_de_limite'::text, 'regla_desactivada'::text, 'nodo_desvinculado'::text]))&#10;FOREIGN KEY (nodo_id) REFERENCES nodos(id)&#10;NOT NULL nodo_id&#10;CHECK (origen = ANY (ARRAY['real'::text, 'simulado'::text]))&#10;NOT NULL origen&#10;PRIMARY KEY (id)&#10;FOREIGN KEY (regla_id) REFERENCES reglas_alerta(id)&#10;NOT NULL regla_id&#10;FOREIGN KEY (revisada_por) REFERENCES perfiles(id)&#10;NOT NULL ultima_tomada_en&#10;NOT NULL umbral&#10;NOT NULL valor_inicial&#10;NOT NULL valor_ultimo&#10;NOT NULL variable_codigo">
