yle="edgeStyle=none;rounded=0;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="net" target="mqtt"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="405" as="sourcePoint" /><mxPoint x="730" y="405" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge3" style="edgeStyle=none;rounded=0;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="mqtt" target="flow"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="405" as="sourcePoint" /><mxPoint x="1020" y="405" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge4" style="edgeStyle=none;rounded=0;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="flow" target="db"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="380" as="sourcePoint" /><mxPoint x="1380" y="300" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge5" style="edgeStyle=none;rounded=0;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;startArrow=block;" edge="1" parent="1" source="flow" target="ai"><mxGeometry relative="1" as="geometry"><mxPoint x="1135" y="480" as="sourcePoint" /><mxPoint x="1135" y="650" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge6" style="edgeStyle=none;rounded=0;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;startArrow=block;" edge="1" parent="1" source="db" target="web"><mxGeometry relative="1" as="geometry"><mxPoint x="1560" y="400" as="sourcePoint" /><mxPoint x="1560" y="650" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge7" style="edgeStyle=none;rounded=0;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;startArrow=block;" edge="1" parent="1" source="web" target="farmer"><mxGeometry relative="1" as="geometry"><mxPoint x="1560" y="800" as="sourcePoint" /><mxPoint x="1560" y="900" as="targetPoint" /></mxGeometry></mxCell><mxCell id="title" value="&lt;b&gt;AgroVigía | Arquitectura lógica propuesta&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=36;" vertex="1" parent="1"><mxGeometry x="60" y="25" width="1650" height="60" as="geometry" /></mxCell><mxCell id="subtitle" value="Iteración documental · 18 de octubre de 2026 · Pendiente de implementación" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=24;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="60" y="85" width="1650" height="50" as="geometry" /></mxCell><mxCell id="forecast" value="&lt;b&gt;Predicción de temperatura · Etapa posterior&lt;/b&gt;&lt;br&gt;&lt;br&gt;Selección y evaluación de un modelo temporal.&lt;br&gt;Función distinta de las sugerencias generadas con Gemini." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;strokeColor=#64748B;fillColor=#FAF5FF;strokeColor=#A78BFA;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="900" height="150" as="geometry" /></mxCell><mxCell id="notes" value="&lt;b&gt;Conectividad y alcance del diseño&lt;/b&gt;&lt;br&gt;&lt;br&gt;Internet será necesario para utilizar Supabase y Gemini.&lt;br&gt;El alojamiento de Mosquitto, n8n y la web queda pendiente de definir.&lt;br&gt;Las flechas representan intercambios de datos, no ubicaciones físicas." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;strokeColor=#64748B;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=20;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="1190" height="185" as="geometry" /></mxCell><mxCell id="label0" value="MQTT" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=19;" vertex="1" parent="1"><mxGeometry x="680" y="360" width="90" height="30" as="geometry" /></mxCell><mxCell id="label1" value="Guarda datos,&lt;br&gt;alertas y&lt;br&gt;sugerencias" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=19;" vertex="1" parent="1"><mxGeometry x="1258" y="235" width="125" height="90" as="geometry" /></mxCell><mxCell id="label2" value="Solicitud /&lt;br&gt;respuesta IA" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=19;" vertex="1" parent="1"><mxGeometry x="1161" y="535" width="180" height="65" as="geometry" /></mxCell><mxCell id="label3" value="Auth y API&lt;br&gt;por HTTPS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=19;" vertex="1" parent="1"><mxGeometry x="1582" y="490" width="170" height="70" as="geometry" /></mxCell><mxCell id="label4" value="Consulta" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=19;" vertex="1" parent="1"><mxGeometry x="1582" y="837" width="150" height="40" as="geometry" /></mxCell><mxCell id="footnote" value="Las reglas producen alertas; Gemini aporta explicaciones contextualizadas. No se mide humedad del suelo." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=20;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="60" y="1052" width="1680" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>