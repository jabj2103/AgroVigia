,{"_type":"UMLActivationView","_id":"AGRO_2214592c8f4749f699ffef2a9307b68c","_parent":{"$ref":"AGRO_26c8a4a140f048628a1b33b1dfc54b6d"},"model":{"$ref":"AGRO_b510d490c71543d88d9a8dd73833fc3e"},"font":"Arial;14;0","left":173,"top":979,"width":14,"height":30,"visible":false}],"font":"Arial;14;0","head":{"$ref":"AGRO_0367f9311e2144fcb699e545e957c372"},"tail":{"$ref":"AGRO_29907c9ce1624fa3a3f658847e97aceb"},"points":"940:979;180:979","nameLabel":{"$ref":"AGRO_3bc03386315b45d991df13b4cdf6777f"},"stereotypeLabel":{"$ref":"AGRO_81674410b81e4de0a225d9a28ff4c5dc"},"propertyLabel":{"$ref":"AGRO_ff71a595df81493c8f3e287a66e93669"},"activation":{"$ref":"AGRO_2214592c8f4749f699ffef2a9307b68c"},"showType":false,"showProperty":false}],"documentation":"Alcance: Agricultor y Sistema AgroVigía. Los componentes internos se diseñarán en una etapa posterior.\nFuncionalidad de predicción prevista para una etapa posterior.\nLos fragmentos alt muestran opciones excluyentes y los opt acciones o avisos opcionales.","showSequenceNumber":false,"sequenceNumbering":"auto","showSignature":true,"showActivation":false}],"documentation":"Diagrama de secuencia del sistema. El agricultor consulta una estimación de temperatura ambiental a corto plazo, generada por un modelo de predicción a partir de mediciones anteriores de un nodo que registra temperatura.\nPrecondiciones: El agricultor tiene una sesión válida y acceso al cultivo que desea consultar.\nPostcondiciones: Cuando existe una predicción vigente, el sistema presenta la temperatura estimada en °C, el nodo, el momento de generación, el momento pronosticado y el origen de los datos utilizados. La estimación se distingue de las mediciones observadas.","messages":[{"_type":"UMLMessage","_id":"AGRO_0c74ec9eb607458e8ca30b8c49d55945","_parent":{"$ref":"AGRO_3b5fb42dcf61445bb1162f08d0a84435"},"name":"abrirPredicciones","arguments":"cultivo","messageSort":"synchCall","source":{"$ref":"AGRO_0bf5e56eaebf49c084a7706622d6a80a"},"target":{"$ref":"AGRO_6d50506